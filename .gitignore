# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vidéos du Hero.
# On exclut le CONTENU du dossier plutôt que le dossier lui-même : git
# n'entre pas dans un répertoire exclu, donc une négation à l'intérieur de
# « /public/video/ » n'aurait jamais pu réinclure quoi que ce soit.
/public/video/*
# La version optimisée (4,43 Mo, sans audio, image clé toutes les 5 images)
# est celle que sert l'application : elle doit être déployée.
!/public/video/hero-optimized.mp4
# L'original (23 Mo) reste une sauvegarde locale, hors dépôt.
